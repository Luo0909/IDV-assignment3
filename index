<body>
    <div class="container">
        <h1>Square Overlap Visualization</h1>
        <div class="description">
            Two unit squares overlap with an area of 2k. The other diagonal of the overlap region is the symmetry axis.
            Adjust k to see how the overlap changes.
        </div>
        <div class="controls">
            <div class="slider-container">
                <label for="k-slider">Overlap parameter k:</label>
                <input type="range" id="k-slider" min="0.1" max="0.4" step="0.01" value="0.2">
                <span id="k-value">0.20</span>
            </div>
        </div>
        <div id="visualization"></div>
        <div class="legend">
            <div class="legend-item">
                <div class="legend-color" style="background-color: rgba(52, 152, 219, 0.4);"></div>
                <span>Square 1 (Bottom-left)</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background-color: rgba(46, 204, 113, 0.4);"></div>
                <span>Square 2 (Top-right)</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background-color: transparent; border: 2px dashed #e74c3c;"></div>
                <span>Overlap (Area = 2k)</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background-color: transparent; border: 2px dashed #9b59b6;"></div>
                <span>Diagonal (Symmetry Axis)</span>
            </div>
        </div>
        <div class="formula">
            Overlap area = 2k | Non-overlap area = 1-2k | Triangles area = k
        </div>
    </div>

    <script>
        // 设置参数和尺寸
        const width = 500;
        const height = 500;
        const margin = 50;
        
        // 创建SVG
        const svg = d3.select("#visualization")
            .append("svg")
            .attr("width", width)
            .attr("height", height);
        
        // 创建缩放和平移变换
        const g = svg.append("g")
            .attr("transform", `translate(${margin}, ${margin})`);
        
        // 初始k值
        let k = 0.2;
        
        // 更新可视化
        function updateVisualization() {
            // 清除之前的绘制
            g.selectAll("*").remove();
            
            // 计算正方形边长
            const side = 200;
            
            // 计算重叠区域边长
            const overlapSide = Math.sqrt(2 * k * side * side);
            
            // 计算两个正方形的偏移量
            const offset = side - overlapSide;
            
            // 绘制左下正方形 (正方形1)
            g.append("rect")
                .attr("class", "square")
                .attr("x", 0)
                .attr("y", 0)
                .attr("width", side)
                .attr("height", side)
                .style("fill", "rgba(52, 152, 219, 0.4)");
            
            // 绘制右上正方形 (正方形2)
            g.append("rect")
                .attr("class", "square")
                .attr("x", offset)
                .attr("y", offset)
                .attr("width", side)
                .attr("height", side)
                .style("fill", "rgba(46, 204, 113, 0.4)");
            
            // 绘制重叠区域
            g.append("rect")
                .attr("class", "overlap")
                .attr("x", offset)
                .attr("y", 0)
                .attr("width", overlapSide)
                .attr("height", overlapSide);
            
            // 绘制另一条对角线（从右上到左下）
            g.append("line")
                .attr("class", "diagonal")
                .attr("x1", offset + overlapSide)
                .attr("y1", 0)
                .attr("x2", offset)
                .attr("y2", overlapSide);
            
            // 计算中心点
            const centerX = offset + overlapSide / 2;
            const centerY = overlapSide / 2;
            
            // 绘制中心点
            g.append("circle")
                .attr("class", "point")
                .attr("cx", centerX)
                .attr("cy", centerY)
                .attr("r", 4);
            
            // 添加中心点标签
            g.append("text")
                .attr("class", "label")
                .attr("x", centerX)
                .attr("y", centerY - 10)
                .text("Center");
            
            // 选择一个点x（在对角线一侧）
            const xX = centerX + 25;
            const xY = centerY - 15;
            
            // 绘制点x
            g.append("circle")
                .attr("class", "point")
                .attr("cx", xX)
                .attr("cy", xY)
                .attr("r", 4);
            
            // 添加点x标签
            g.append("text")
                .attr("class", "label")
                .attr("x", xX)
                .attr("y", xY - 10)
                .text("x");
            
            // 计算sigma1和sigma2
            const sigma1 = Math.abs(xY - centerY);
            const sigma2 = Math.abs(xX - centerX);
            
            // 绘制sigma1和sigma2
            g.append("line")
                .attr("class", "line")
                .attr("x1", xX)
                .attr("y1", xY)
                .attr("x2", xX)
                .attr("y2", centerY);
            
            g.append("line")
                .attr("class", "line")
                .attr("x1", xX)
                .attr("y1", xY)
                .attr("x2", centerX)
                .attr("y2", xY);
            
            // 添加sigma1标签
            g.append("text")
                .attr("class", "label")
                .attr("x", xX + 10)
                .attr("y", (xY + centerY) / 2)
                .text(`σ₁ = ${sigma1.toFixed(1)}`);
            
            // 添加sigma2标签
            g.append("text")
                .attr("class", "label")
                .attr("x", (xX + centerX) / 2)
                .attr("y", xY - 10)
                .text(`σ₂ = ${sigma2.toFixed(1)}`);
            
            // 计算x'（关于对角线的对称点）
            // 使用点关于直线的对称点公式
            // 对角线方程: (x - offset) + (y - 0) = overlapSide 或 x + y = offset + overlapSide
            const a = 1; // 对角线斜率 -1，但这里我们使用一般式
            const b = 1;
            const c = -(offset + overlapSide);
            
            const d = (a * xX + b * xY + c) / (a * a + b * b);
            const xPrimeX = xX - 2 * a * d;
            const xPrimeY = xY - 2 * b * d;
            
            // 绘制点x'
            g.append("circle")
                .attr("class", "point")
                .attr("cx", xPrimeX)
                .attr("cy", xPrimeY)
                .attr("r", 4);
            
            // 添加点x'标签
            g.append("text")
                .attr("class", "label")
                .attr("x", xPrimeX)
                .attr("y", xPrimeY - 10)
                .text("x'");
            
            // 绘制从x到x'的连线，显示对称关系
            g.append("line")
                .attr("class", "line")
                .attr("x1", xX)
                .attr("y1", xY)
                .attr("x2", xPrimeX)
                .attr("y2", xPrimeY)
                .style("stroke", "#e74c3c")
                .style("stroke-dasharray", "3,3");
            
            // 标注面积k的三角形
            // 左上三角形
            g.append("polygon")
                .attr("class", "triangle")
                .attr("points", `${offset},0 ${offset+overlapSide},0 ${offset},${overlapSide}`)
                .style("fill", "rgba(241, 196, 15, 0.3)")
                .style("stroke", "rgba(241, 196, 15, 0.8)");
            
            // 右下三角形
            g.append("polygon")
                .attr("class", "triangle")
                .attr("points", `${offset+overlapSide},0 ${offset+overlapSide},${overlapSide} ${offset},${overlapSide}`)
                .style("fill", "rgba(241, 196, 15, 0.3)")
                .style("stroke", "rgba(241, 196, 15, 0.8)");
            
            // 添加面积k标签
            g.append("text")
                .attr("class", "label")
                .attr("x", offset + overlapSide/2)
                .attr("y", overlapSide/2 + 15)
                .text(`Area = k`);
            
            // 标注未重叠区域
            // 左下正方形未重叠部分
            g.append("rect")
                .attr("class", "non-overlap")
                .attr("x", 0)
                .attr("y", 0)
                .attr("width", offset)
                .attr("height", side)
                .style("fill", "rgba(52, 152, 219, 0.2)")
                .style("stroke", "rgba(52, 152, 219, 0.6)");
            
            // 右上正方形未重叠部分
            g.append("rect")
                .attr("class", "non-overlap")
                .attr("x", offset + overlapSide)
                .attr("y", offset)
                .attr("width", side - overlapSide)
                .attr("height", side)
                .style("fill", "rgba(46, 204, 113, 0.2)")
                .style("stroke", "rgba(46, 204, 113, 0.6)");
            
            // 添加未重叠区域标签
            g.append("text")
                .attr("class", "label")
                .attr("x", offset/2)
                .attr("y", side/2)
                .text(`Area = 1-2k`);
            
            g.append("text")
                .attr("class", "label")
                .attr("x", offset + overlapSide + (side - overlapSide)/2)
                .attr("y", offset + side/2)
                .text(`Area = 1-2k`);
            
            // 添加标题
            g.append("text")
                .attr("class", "label")
                .attr("x", side/2)
                .attr("y", -20)
                .style("font-size", "16px")
                .style("font-weight", "bold")
                .text(`Overlap Area: 2k = ${(2*k).toFixed(2)}`);
        }
        
        // 初始化可视化
        updateVisualization();
        
        // 添加滑块事件监听
        d3.select("#k-slider")
            .on("input", function() {
                k = parseFloat(this.value);
                d3.select("#k-value").text(k.toFixed(2));
                updateVisualization();
            });
    </script>
</body>
</html>
