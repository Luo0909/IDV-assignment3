        defs.append("marker")
            .attr("id", "arrowhead")
            .attr("viewBox", "0 -5 10 10")
            .attr("refX", 8)
            .attr("refY", 0)
            .attr("markerWidth", 6)
            .attr("markerHeight", 6)
            .attr("orient", "auto")
            .append("path")
            .attr("d", "M0,-5L10,0L0,5")
            .attr("fill", "#95a5a6");
            
        defs.append("marker")
            .attr("id", "data-arrow")
            .attr("viewBox", "0 -5 10 10")
            .attr("refX", 8)
            .attr("refY", 0)
            .attr("markerWidth", 6)
            .attr("markerHeight", 6)
            .attr("orient", "auto")
            .append("path")
            .attr("d", "M0,-5L10,0L0,5")
            .attr("fill", "#e74c3c");
        
        // 绘制连接线
        const link = svg.selectAll(".connection")
            .data(connections)
            .enter()
            .append("path")
            .attr("class", "connection")
            .attr("d", d => {
                const source = components.find(c => c.id === d.source);
                const target = components.find(c => c.id === d.target);
                return `M ${source.x + source.width} ${source.y + source.height/2} 
                        L ${target.x} ${target.y + target.height/2}`;
            })
            .attr("fill", "none")
            .attr("stroke", "#95a5a6")
            .attr("stroke-width", 2)
            .attr("marker-end", "url(#arrowhead)");
        
        // 绘制组件
        const node = svg.selectAll(".component")
            .data(components)
            .enter()
            .append("g")
            .attr("class", "node")
            .attr("transform", d => `translate(${d.x}, ${d.y})`);
        
        // 添加矩形
        node.append("rect")
            .attr("width", d => d.width)
            .attr("height", d => d.height)
            .attr("fill", d => d.color)
            .attr("rx", 6)
            .attr("ry", 6)
            .attr("stroke", "#fff")
            .attr("stroke-width", 2);
        
        // 添加标题
        node.append("text")
            .attr("x", d => d.width / 2)
            .attr("y", d => d.height / 2)
            .attr("text-anchor", "middle")
            .attr("dy", "0.35em")
            .attr("fill", "white")
            .attr("font-weight", "bold")
            .attr("font-size", "11px")
            .text(d => d.title);
        
        // 为特定组件添加详细文本
        const tokenEmbeddingsInput = node.filter(d => d.id === "token-embeddings-input");
        tokenEmbeddingsInput.append("text")
            .attr("x", d => d.width / 2)
            .attr("y", d => d.height / 2 - 10)
            .attr("class", "embeddings-text")
            .text("Token");
        tokenEmbeddingsInput.append("text")
            .attr("x", d => d.width / 2)
            .attr("y", d => d.height / 2 + 5)
            .attr("class", "embeddings-text")
            .text("Embeddings");
        tokenEmbeddingsInput.append("text")
            .attr("x", d => d.width / 2)
            .attr("y", d => d.height / 2 + 20)
            .attr("class", "embeddings-text")
            .text("Input Sequence");
            
        const positionalEmbeddings = node.filter(d => d.id === "positional-embeddings");
        positionalEmbeddings.append("text")
            .attr("x", d => d.width / 2)
            .attr("y", d => d.height / 2 - 10)
            .attr("class", "embeddings-text")
            .text("Positional");
        positionalEmbeddings.append("text")
            .attr("x", d => d.width / 2)
            .attr("y", d => d.height / 2 + 10)
            .attr("class", "embeddings-text")
            .text("Embeddings");
            
        const outputEmbeddings = node.filter(d => d.id === "output-embeddings");
        outputEmbeddings.append("text")
            .attr("x", d => d.width / 2)
            .attr("y", d => d.height / 2 - 15)
            .attr("class", "embeddings-text")
            .text("Output");
        outputEmbeddings.append("text")
            .attr("x", d => d.width / 2)
            .attr("y", d => d.height / 2)
            .attr("class", "embeddings-text")
            .text("Token");
        outputEmbeddings.append("text")
            .attr("x", d => d.width / 2)
            .attr("y", d => d.height / 2 + 15)
            .attr("class", "embeddings-text")
            .text("Embeddings");
        
        // 添加分区标题
        svg.append("text")
            .attr("class", "section-title")
            .attr("x", 170)
            .attr("y", 80)
            .text("Input Processing");
        
        svg.append("text")
            .attr("class", "section-title")
            .attr("x", 510)
            .attr("y", 80)
            .text("Decoder Layers (N stacked layers)");
        
        svg.append("text")
            .attr("class", "section-title")
            .attr("x", 1010)
            .attr("y", 80)
            .text("Output Generation");
        
        // 添加注意力掩码示意图
        const attentionMask = svg.append("g")
            .attr("class", "attention-mask-group")
            .style("opacity", 0);
            
        // 创建掩码矩阵
        const maskSize = 120;
        const maskX = 500;
        const maskY = 520;
        const cellSize = maskSize / 5;
        
        // 绘制掩码矩阵背景
        attentionMask.append("rect")
            .attr("x", maskX)
            .attr("y", maskY)
            .attr("width", maskSize)
            .attr("height", maskSize)
            .attr("fill", "#f8f9fa")
            .attr("stroke", "#95a5a6")
            .attr("stroke-width", 1);
            
        // 添加标题
        attentionMask.append("text")
            .attr("x", maskX + maskSize/2)
            .attr("y", maskY - 10)
            .attr("text-anchor", "middle")
            .attr("fill", "#2c3e50")
            .attr("font-weight", "bold")
            .text("Masked Attention Matrix");
            
        // 绘制掩码矩阵
        for (let i = 0; i < 5; i++) {
            for (let j = 0; j < 5; j++) {
                const cell = attentionMask.append("rect")
                    .attr("x", maskX + i * cellSize)
                    .attr("y", maskY + j * cellSize)
                    .attr("width", cellSize)
                    .attr("height", cellSize)
                    .attr("fill", j <= i ? "#3498db" : "#e74c3c")
                    .attr("stroke", "#fff")
                    .attr("stroke-width", 1);
                    
                // 添加对角线动画
                if (j <= i) {
                    cell.attr("class", "attention-mask")
                        .style("stroke", "#3498db")
                        .style("stroke-width", 2);
                }
            }
        }
        
        // 添加图例
        attentionMask.append("rect")
            .attr("x", maskX)
            .attr("y", maskY + maskSize + 10)
            .attr("width", 15)
            .attr("height", 15)
            .attr("fill", "#3498db");
            
        attentionMask.append("text")
            .attr("x", maskX + 20)
            .attr("y", maskY + maskSize + 22)
            .attr("fill", "#2c3e50")
            .attr("font-size", "12px")
            .text("Allowed Attention");
            
        attentionMask.append("rect")
            .attr("x", maskX + 80)
            .attr("y", maskY + maskSize + 10)
            .attr("width", 15)
            .attr("height", 15)
            .attr("fill", "#e74c3c");
            
        attentionMask.append("text")
            .attr("x", maskX + 100)
            .attr("y", maskY + maskSize + 22)
            .attr("fill", "#2c3e50")
            .attr("font-size", "12px")
            .text("Masked (No Attention)");
        
        // 添加交互功能
        node.on("mouseover", function(event, d) {
            tooltip.transition()
                .duration(200)
                .style("opacity", .9);
            tooltip.html(`<strong>${d.title}</strong><br/>${d.description}`)
                .style("left", (event.pageX + 10) + "px")
                .style("top", (event.pageY - 28) + "px");
            
            // 高亮相关连接线
            link.style("stroke", l => 
                (l.source === d.id || l.target === d.id) ? "#e74c3c" : "#95a5a6")
                .style("stroke-width", l => 
                (l.source === d.id || l.target === d.id) ? 3 : 2);
        })
        .on("mouseout", function(event, d) {
            tooltip.transition()
                .duration(500)
                .style("opacity", 0);
            
            // 恢复连接线样式
            link.style("stroke", "#95a5a6")
                .style("stroke-width", 2);
        });
        
        // 添加控制按钮功能
        let labelsVisible = true;
        let attentionVisible = false;
        
        d3.select("#toggle-labels").on("click", function() {
            labelsVisible = !labelsVisible;
            node.select("text")
                .style("visibility", labelsVisible ? "visible" : "hidden");
        });
        
        d3.select("#show-attention").on("click", function() {
            attentionVisible = !attentionVisible;
            attentionMask.transition()
                .duration(500)
                .style("opacity", attentionVisible ? 1 : 0);
        });
        
        d3.select("#animate-flow").on("click", function() {
            // 创建数据流动画
            const flowPath = [
                { x: 80, y: 415 },
                { x: 320, y: 300 },
                { x: 500, y: 300 },
                { x: 680, y: 300 },
                { x: 860, y: 300 },
                { x: 920, y: 230 },
                { x: 920, y: 335 },
                { x: 920, y: 385 },
                { x: 1100, y: 385 }
            ];
            
            // 创建流动的圆点
            const circle = svg.append("circle")
                .attr("r", 6)
                .attr("fill", "#e74c3c")
                .attr("cx", flowPath[0].x)
                .attr("cy", flowPath[0].y)
                .style("opacity", 0);
            
            // 动画函数
            circle.transition()
                .duration(500)
                .style("opacity", 1)
                .transition()
                .duration(4000)
                .attrTween("transform", function() {
                    return function(t) {
                        const pointIndex = Math.floor(t * (flowPath.length - 1));
                        const point = flowPath[pointIndex];
                        const nextPoint = flowPath[pointIndex + 1] || flowPath[flowPath.length - 1];
                        const progress = (t * (flowPath.length - 1)) % 1;
                        
                        const x = point.x + (nextPoint.x - point.x) * progress;
                        const y = point.y + (nextPoint.y - point.y) * progress;
                        
                        return `translate(${x}, ${y})`;
                    };
                })
                .style("opacity", 0)
                .on("end", function() {
                    d3.select(this).remove();
                });
        });
        
        d3.select("#reset-view").on("click", function() {
            // 重置所有样式
            node.attr("transform", d => `translate(${d.x}, ${d.y})`)
                .select("rect")
                .attr("fill", d => d.color);
                
            link.style("stroke", "#95a5a6")
                .style("stroke-width", 2);
                
            labelsVisible = true;
            node.select("text").style("visibility", "visible");
            
            attentionVisible = false;
            attentionMask.style("opacity", 0);
        });
    </script>
</body>
</html>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive Stick Figure SVG</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .container {
            display: flex;
            flex-direction: column;
            align-items: center;
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            max-width: 500px;
            width: 90%;
        }
        
        h1 {
            color: #333;
            margin-bottom: 20px;
            text-align: center;
        }
        
        .controls {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
            justify-content: center;
        }
        
        button {
            background: #4a6fa5;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        button:hover {
            background: #385d8a;
            transform: translateY(-2px);
            box-shadow: 0 6px 8px rgba(0, 0, 0, 0.15);
        }
        
        button:active {
            transform: translateY(0);
        }
        
        .svg-container {
            position: relative;
            width: 100%;
            height: 400px;
            overflow: visible;
        }
        
        svg {
            display: block;
            margin: 0 auto;
            transition: all 0.5s ease;
        }
        
        /* 可交互元素 */
        .interactive {
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .interactive:hover {
            stroke-width: 4px !important;
            stroke: #ff6b6b !important;
        }
        
        /* 动画类 */
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        
        @keyframes wave {
            0%, 100% { transform: rotate(0deg); }
            25% { transform: rotate(5deg); }
            75% { transform: rotate(-5deg); }
        }
        
        @keyframes tv-static {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        
        @keyframes expression-change {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }
        
        @keyframes pencil-draw {
            0% { transform: translateX(0) rotate(0deg); }
            100% { transform: translateX(20px) rotate(5deg); }
        }
        
        .bounce {
            animation: bounce 1s ease infinite;
        }
        
        .wave {
            animation: wave 1.5s ease infinite;
            transform-origin: 200px 220px;
        }
        
        .tv-static {
            animation: tv-static 0.5s linear infinite;
        }
        
        .expression-change {
            animation: expression-change 2s ease infinite;
        }
        
        .pencil-draw {
            animation: pencil-draw 2s ease infinite alternate;
            transform-origin: 240px 230px;
        }
        
        .hidden {
            opacity: 0;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Interactive Stick Figure SVG</h1>
        
        <div class="controls">
            <button id="toggleAnimation">Toggle Animation</button>
            <button id="changeExpression">Change Expression</button>
            <button id="drawEffect">Drawing Effect</button>
            <button id="resetAll">Reset All</button>
        </div>
        
        <div class="svg-container">
            <svg width="400" height="400" viewBox="0 0 400 400" id="main-svg">
                <!-- Cuboid seat -->
                <rect x="100" y="250" width="200" height="20" fill="none" stroke="#333" stroke-width="2" class="interactive" id="seat" />
                <rect x="100" y="250" width="20" height="60" fill="none" stroke="#333" stroke-width="2" />
                <rect x="280" y="250" width="20" height="60" fill="none" stroke="#333" stroke-width="2" />
                <rect x="100" y="310" width="200" height="20" fill="none" stroke="#333" stroke-width="2" />
                
                <!-- Stick figure body -->
                <!-- Torso -->
                <line x1="200" y1="200" x2="200" y2="250" stroke="#333" stroke-width="3" class="interactive" id="torso" />
                
                <!-- Legs -->
                <line x1="200" y1="250" x2="180" y2="280" stroke="#333" stroke-width="3" class="interactive" id="left-leg" />
                <line x1="200" y1="250" x2="220" y2="280" stroke="#333" stroke-width="3" class="interactive" id="right-leg" />
                
                <!-- Arms -->
                <line x1="200" y1="220" x2="160" y2="230" stroke="#333" stroke-width="3" class="interactive wave" id="left-arm" />
                <line x1="200" y1="220" x2="240" y2="230" stroke="#333" stroke-width="3" class="interactive" id="right-arm" />
                
                <!-- TV head -->
                <rect x="170" y="140" width="60" height="50" fill="none" stroke="#333" stroke-width="2" class="interactive tv-static" id="tv-head" />
                <rect x="175" y="145" width="50" height="40" fill="none" stroke="#333" stroke-width="1" />
                
                <!-- TV antennas -->
                <line x1="185" y1="140" x2="175" y2="120" stroke="#333" stroke-width="2" class="interactive" />
                <circle cx="175" cy="120" r="3" fill="none" stroke="#333" stroke-width="1" class="interactive" />
                <line x1="215" y1="140" x2="225" y2="120" stroke="#333" stroke-width="2" class="interactive" />
                <circle cx="225" cy="120" r="3" fill="none" stroke="#333" stroke-width="1" class="interactive" />
                
                <!-- Expression - neutral lines -->
                <line x1="180" y1="160" x2="190" y2="160" stroke="#333" stroke-width="2" class="expression" id="left-eye" />
                <line x1="210" y1="160" x2="220" y2="160" stroke="#333" stroke-width="2" class="expression" id="right-eye" />
                <line x1="185" y1="175" x2="215" y2="175" stroke="#333" stroke-width="2" class="expression" id="mouth" />
                
                <!-- Alternate expression - smile -->
                <line x1="180" y1="160" x2="190" y2="160" stroke="#333" stroke-width="2" class="expression hidden" id="left-eye-smile" />
                <line x1="210" y1="160" x2="220" y2="160" stroke="#333" stroke-width="2" class="expression hidden" id="right-eye-smile" />
                <path d="M185 175 Q200 185 215 175" stroke="#333" stroke-width="2" fill="none" class="expression hidden" id="mouth-smile" />
                
                <!-- Alternate expression - surprise -->
                <circle cx="185" cy="160" r="3" fill="none" stroke="#333" stroke-width="1" class="expression hidden" id="left-eye-surprise" />
                <circle cx="215" cy="160" r="3" fill="none" stroke="#333" stroke-width="1" class="expression hidden" id="right-eye-surprise" />
                <circle cx="200" cy="175" r="5" fill="none" stroke="#333" stroke-width="1" class="expression hidden" id="mouth-surprise" />
                
                <!-- Paper in left hand -->
                <rect x="130" y="200" width="40" height="30" fill="none" stroke="#333" stroke-width="1" class="interactive" id="paper" />
                <!-- Text on paper (unclear) -->
                <path d="M135 210 Q140 205 145 210 T155 210" stroke="#aaa" stroke-width="1" fill="none" />
                <path d="M135 215 Q140 212 145 215 T155 215" stroke="#aaa" stroke-width="1" fill="none" />
                <path d="M135 220 Q140 218 145 220 T155 220" stroke="#aaa" stroke-width="1" fill="none" />
                
                <!-- Pencil in right hand -->
                <line x1="240" y1="230" x2="260" y2="220" stroke="#333" stroke-width="3" class="interactive pencil-draw" id="pencil" />
                <line x1="260" y1="220" x2="265" y2="215" stroke="#333" stroke-width="3" />
                <polygon points="265,215 270,217 265,219" fill="none" stroke="#333" stroke-width="1" />
                
                <!-- Drawing line effect -->
                <path d="M265 217 Q280 220 290 210" stroke="#ff6b6b" stroke-width="2" fill="none" class="hidden" id="draw-line" />
            </svg>
        </div>
    </div>

    <script>
        // Get DOM elements
        const toggleAnimationBtn = document.getElementById('toggleAnimation');
        const changeExpressionBtn = document.getElementById('changeExpression');
        const drawEffectBtn = document.getElementById('drawEffect');
        const resetAllBtn = document.getElementById('resetAll');
        
        const svg = document.getElementById('main-svg');
        const leftArm = document.getElementById('left-arm');
        const tvHead = document.getElementById('tv-head');
        const pencil = document.getElementById('pencil');
        const drawLine = document.getElementById('draw-line');
        
        // Expression elements
        const expressions = document.querySelectorAll('.expression');
        const leftEye = document.getElementById('left-eye');
        const rightEye = document.getElementById('right-eye');
        const mouth = document.getElementById('mouth');
        const leftEyeSmile = document.getElementById('left-eye-smile');
        const rightEyeSmile = document.getElementById('right-eye-smile');
        const mouthSmile = document.getElementById('mouth-smile');
        const leftEyeSurprise = document.getElementById('left-eye-surprise');
        const rightEyeSurprise = document.getElementById('right-eye-surprise');
        const mouthSurprise = document.getElementById('mouth-surprise');
        
        // State variables
        let isAnimating = true;
        let currentExpression = 0; // 0: neutral, 1: smile, 2: surprise
        
        // Toggle animation
        toggleAnimationBtn.addEventListener('click', function() {
            isAnimating = !isAnimating;
            
            if (isAnimating) {
                leftArm.classList.add('wave');
                tvHead.classList.add('tv-static');
                pencil.classList.add('pencil-draw');
                toggleAnimationBtn.textContent = 'Pause Animation';
            } else {
                leftArm.classList.remove('wave');
                tvHead.classList.remove('tv-static');
                pencil.classList.remove('pencil-draw');
                toggleAnimationBtn.textContent = 'Resume Animation';
            }
        });
        
        // Change expression
        changeExpressionBtn.addEventListener('click', function() {
            // Hide all expressions
            expressions.forEach(exp => exp.classList.add('hidden'));
            
            // Switch to next expression
            currentExpression = (currentExpression + 1) % 3;
            
            // Show current expression
            if (currentExpression === 0) {
                // Neutral expression
                leftEye.classList.remove('hidden');
                rightEye.classList.remove('hidden');
                mouth.classList.remove('hidden');
                changeExpressionBtn.textContent = 'Expression: Neutral';
            } else if (currentExpression === 1) {
                // Smile expression
                leftEyeSmile.classList.remove('hidden');
                rightEyeSmile.classList.remove('hidden');
                mouthSmile.classList.remove('hidden');
                changeExpressionBtn.textContent = 'Expression: Smile';
            } else {
                // Surprise expression
                leftEyeSurprise.classList.remove('hidden');
                rightEyeSurprise.classList.remove('hidden');
                mouthSurprise.classList.remove('hidden');
                changeExpressionBtn.textContent = 'Expression: Surprise';
            }
        });
        
        // Drawing effect
        drawEffectBtn.addEventListener('click', function() {
            // Show drawing line
            drawLine.classList.remove('hidden');
            
            // Add pencil animation
            pencil.classList.add('pencil-draw');
            
            // Hide drawing line after 3 seconds
            setTimeout(() => {
                drawLine.classList.add('hidden');
            }, 3000);
        });
        
        // Reset all
        resetAllBtn.addEventListener('click', function() {
            // Reset animation
            isAnimating = true;
            leftArm.classList.add('wave');
            tvHead.classList.add('tv-static');
            pencil.classList.add('pencil-draw');
            toggleAnimationBtn.textContent = 'Pause Animation';
            
            // Reset expression to neutral
            currentExpression = 0;
            expressions.forEach(exp => exp.classList.add('hidden'));
            leftEye.classList.remove('hidden');
            rightEye.classList.remove('hidden');
            mouth.classList.remove('hidden');
            changeExpressionBtn.textContent = 'Change Expression';
            
            // Hide drawing line
            drawLine.classList.add('hidden');
        });
        
        // Add click interaction for SVG elements
        const interactiveElements = document.querySelectorAll('.interactive');
        interactiveElements.forEach(element => {
            element.addEventListener('click', function() {
                // Add click effect - temporarily change color
                const originalColor = this.getAttribute('stroke');
                this.setAttribute('stroke', '#ff6b6b');
                
                setTimeout(() => {
                    this.setAttribute('stroke', originalColor);
                }, 500);
            });
        });
    </script>
</body>
</html>


