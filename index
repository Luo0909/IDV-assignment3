<body>
    <div class="container">
        <div class="chart-container">
            <div class="title">Chart 5 (math plots)</div>
            <div id="bar-chart"></div>
            <button id="animate-bar" class="button">Replay Bar Chart Animation</button>
        </div>
        <div class="chart-container">
            <div id="line-chart"></div>
            <button id="animate-line" class="button">Replay Line Chart Animation</button>
        </div>
    </div>

    <div id="tooltip" class="tooltip"></div>

    <script>
        // 设置尺寸和边距
        const margin = {top: 40, right: 30, bottom: 50, left: 60};
        const width = 600 - margin.left - margin.right;
        const height = 300 - margin.top - margin.bottom;

        // 创建工具提示
        const tooltip = d3.select("#tooltip");

        // 创建第一张图 - 柱状图
        const svg1 = d3.select("#bar-chart")
            .append("svg")
            .attr("width", width + margin.left + margin.right)
            .attr("height", height + margin.top + margin.bottom)
            .append("g")
            .attr("transform", `translate(${margin.left},${margin.top})`);

        // 生成数据 - 只显示一个柱状
        const barData = [{
            iOverN: 0.3,
            iPlusDeltaOverN: 0.5,
            p1: 15, // Low p1
            p2: 35  // High p2
        }];

        // 设置比例尺
        const xScale1 = d3.scaleLinear()
            .domain([0, 1])
            .range([0, width]);

        const yScale1 = d3.scaleLinear()
            .domain([0, 50])
            .range([height, 0]);

        // 添加坐标轴
        svg1.append("g")
            .attr("transform", `translate(0,${height})`)
            .call(d3.axisBottom(xScale1).ticks(5));

        svg1.append("g")
            .call(d3.axisLeft(yScale1).ticks(5));

        // 添加柱状图 - 初始状态高度为0
        const bars = svg1.selectAll(".bar")
            .data(barData)
            .enter()
            .append("rect")
            .attr("class", "bar")
            .attr("x", d => xScale1(d.iOverN))
            .attr("y", height) // 从底部开始
            .attr("width", d => xScale1(d.iPlusDeltaOverN) - xScale1(d.iOverN))
            .attr("height", 0) // 初始高度为0
            .attr("fill", "purple")
            .attr("fill-opacity", 0.7)
            .style("stroke", "purple")
            .style("stroke-dasharray", "5,5")
            .style("stroke-width", 1)
            .on("mouseover", function(event, d) {
                tooltip
                    .style("opacity", 1)
                    .html(`i/n: ${d.iOverN}<br>(i+Δn)/n: ${d.iPlusDeltaOverN}<br>p₁: ${d.p1}<br>p₂: ${d.p2}`)
                    .style("left", (event.pageX + 10) + "px")
                    .style("top", (event.pageY - 28) + "px");
            })
            .on("mouseout", function() {
                tooltip.style("opacity", 0);
            });

        // 添加p2区域 - 初始状态高度为0
        const p2Areas = svg1.selectAll(".p2-area")
            .data(barData)
            .enter()
            .append("rect")
            .attr("class", "p2-area")
            .attr("x", d => xScale1(d.iOverN))
            .attr("y", height) // 从底部开始
            .attr("width", d => xScale1(d.iPlusDeltaOverN) - xScale1(d.iOverN))
            .attr("height", 0) // 初始高度为0
            .attr("fill", "purple")
            .attr("fill-opacity", 0.3)
            .style("stroke", "purple")
            .style("stroke-dasharray", "5,5")
            .style("stroke-width", 1)
            .on("mouseover", function(event, d) {
                tooltip
                    .style("opacity", 1)
                    .html(`i/n: ${d.iOverN}<br>(i+Δn)/n: ${d.iPlusDeltaOverN}<br>p₁: ${d.p1}<br>p₂: ${d.p2}`)
                    .style("left", (event.pageX + 10) + "px")
                    .style("top", (event.pageY - 28) + "px");
            })
            .on("mouseout", function() {
                tooltip.style("opacity", 0);
            });

        // 添加横轴标签 - i/n 和 (i+Δn)/n 分别对齐柱状图左右两侧
        svg1.append("text")
            .attr("x", xScale1(0.3))
            .attr("y", height + 25)
            .attr("text-anchor", "middle")
            .style("font-size", "12px")
            .text("i/n");

        svg1.append("text")
            .attr("x", xScale1(0.5))
            .attr("y", height + 25)
            .attr("text-anchor", "middle")
            .style("font-size", "12px")
            .text("(i+Δn)/n");

        // 添加图例
        const legend1 = svg1.append("g")
            .attr("class", "legend")
            .attr("transform", `translate(${width - 120}, 10)`);

        legend1.append("rect")
            .attr("x", 0)
            .attr("y", 0)
            .attr("width", 12)
            .attr("height", 12)
            .attr("fill", "purple")
            .attr("fill-opacity", 0.7)
            .style("stroke", "purple")
            .style("stroke-dasharray", "5,5");

        legend1.append("text")
            .attr("x", 20)
            .attr("y", 10)
            .text("(Low) p₁");

        legend1.append("rect")
            .attr("x", 0)
            .attr("y", 20)
            .attr("width", 12)
            .attr("height", 12)
            .attr("fill", "purple")
            .attr("fill-opacity", 0.3)
            .style("stroke", "purple")
            .style("stroke-dasharray", "5,5");

        legend1.append("text")
            .attr("x", 20)
            .attr("y", 30)
            .text("(High) p₂");

        // 柱状图过渡动画函数
        function animateBarChart() {
            bars.transition()
                .duration(1000)
                .attr("y", d => yScale1(d.p1))
                .attr("height", d => height - yScale1(d.p1));

            p2Areas.transition()
                .duration(1000)
                .delay(500)
                .attr("y", d => yScale1(d.p2))
                .attr("height", d => yScale1(d.p1) - yScale1(d.p2));
        }

        // 初始播放柱状图动画
        setTimeout(animateBarChart, 500);

        // 第二张图 - 曲线图
        const svg2 = d3.select("#line-chart")
            .append("svg")
            .attr("width", width + margin.left + margin.right)
            .attr("height", height + margin.top + margin.bottom)
            .append("g")
            .attr("transform", `translate(${margin.left},${margin.top})`);

        // 生成曲线数据 - 起点不与纵轴重合
        const lineData = [];
        for (let i = 0; i <= 100; i++) {
            const x = i / 100;
            
            // 上方虚线 - 从x=0.1开始，避免与纵轴重合
            let y1;
            if (x < 0.1) {
                y1 = null; // 在0.1之前不绘制
            } else if (x < 0.5) {
                y1 = 40; // 前半段保持水平
            } else {
                // 后半段抛物线，从40下降到15
                const t = (x - 0.5) * 2; // 将0.5-1映射到0-1
                y1 = 40 - 25 * t * t; // 抛物线下降
            }
            
            // 下方实线 - 从x=0.1开始，避免与纵轴重合
            let y2;
            if (x < 0.1) {
                y2 = null; // 在0.1之前不绘制
            } else if (x < 0.5) {
                y2 = 25; // 前半段保持水平
            } else {
                // 后半段抛物线，从25下降到5
                const t = (x - 0.5) * 2; // 将0.5-1映射到0-1
                y2 = 25 - 20 * t * t; // 抛物线下降
            }
            
            lineData.push({
                x: x,
                y1: y1,
                y2: y2
            });
        }

        // 设置比例尺
        const xScale2 = d3.scaleLinear()
            .domain([0, 1])
            .range([0, width]);

        const yScale2 = d3.scaleLinear()
            .domain([0, 40])
            .range([height, 0]);

        // 添加坐标轴
        svg2.append("g")
            .attr("transform", `translate(0,${height})`)
            .call(d3.axisBottom(xScale2).ticks(3).tickValues([0, 0.5, 1]))
            .append("text")
            .attr("x", width / 2)
            .attr("y", 35)
            .attr("fill", "black")
            .attr("class", "axis-label")
            .text("position");

        svg2.append("g")
            .call(d3.axisLeft(yScale2).ticks(3).tickValues([0, 20, 40]));

        // 创建线条生成器 - 过滤掉null值
        const line1 = d3.line()
            .x(d => xScale2(d.x))
            .y(d => d.y1 !== null ? yScale2(d.y1) : null)
            .defined(d => d.y1 !== null)
            .curve(d3.curveMonotoneX);

        const line2 = d3.line()
            .x(d => xScale2(d.x))
            .y(d => d.y2 !== null ? yScale2(d.y2) : null)
            .defined(d => d.y2 !== null)
            .curve(d3.curveMonotoneX);

        // 添加曲线 - 初始状态为长度为0的路径
        const path1 = svg2.append("path")
            .datum(lineData)
            .attr("class", "line")
            .attr("d", line1)
            .style("fill", "none")
            .style("stroke", "steelblue")
            .style("stroke-width", 2)
            .style("stroke-dasharray", "5,5");

        const path2 = svg2.append("path")
            .datum(lineData)
            .attr("class", "line")
            .attr("d", line2)
            .style("fill", "none")
            .style("stroke", "darkorange")
            .style("stroke-width", 2);

        // 添加交互点
        const dots1 = svg2.selectAll(".dot1")
            .data(lineData.filter(d => d.y1 !== null))
            .enter()
            .append("circle")
            .attr("class", "dot1")
            .attr("cx", d => xScale2(d.x))
            .attr("cy", d => yScale2(d.y1))
            .attr("r", 3)
            .style("fill", "steelblue")
            .style("opacity", 0)
            .on("mouseover", function(event, d) {
                tooltip
                    .style("opacity", 1)
                    .html(`Position: ${d.x.toFixed(2)}<br>Value: ${d.y1.toFixed(1)}`)
                    .style("left", (event.pageX + 10) + "px")
                    .style("top", (event.pageY - 28) + "px");
            })
            .on("mouseout", function() {
                tooltip.style("opacity", 0);
            });

        const dots2 = svg2.selectAll(".dot2")
            .data(lineData.filter(d => d.y2 !== null))
            .enter()
            .append("circle")
            .attr("class", "dot2")
            .attr("cx", d => xScale2(d.x))
            .attr("cy", d => yScale2(d.y2))
            .attr("r", 3)
            .style("fill", "darkorange")
            .style("opacity", 0)
            .on("mouseover", function(event, d) {
                tooltip
                    .style("opacity", 1)
                    .html(`Position: ${d.x.toFixed(2)}<br>Value: ${d.y2.toFixed(1)}`)
                    .style("left", (event.pageX + 10) + "px")
                    .style("top", (event.pageY - 28) + "px");
            })
            .on("mouseout", function() {
                tooltip.style("opacity", 0);
            });

        // 曲线图过渡动画函数
        function animateLineChart() {
            // 重置路径长度为0
            const totalLength1 = path1.node().getTotalLength();
            const totalLength2 = path2.node().getTotalLength();
            
            path1
                .attr("stroke-dasharray", totalLength1 + " " + totalLength1)
                .attr("stroke-dashoffset", totalLength1)
                .transition()
                .duration(2000)
                .ease(d3.easeLinear)
                .attr("stroke-dashoffset", 0);

            path2
                .attr("stroke-dasharray", totalLength2 + " " + totalLength2)
                .attr("stroke-dashoffset", totalLength2)
                .transition()
                .duration(2000)
                .delay(1000)
                .ease(d3.easeLinear)
                .attr("stroke-dashoffset", 0);

            // 显示交互点
            dots1.transition()
                .duration(500)
                .delay(2000)
                .style("opacity", 1);

            dots2.transition()
                .duration(500)
                .delay(2500)
                .style("opacity", 1);
        }

        // 初始播放曲线图动画
        setTimeout(animateLineChart, 2000);

        // 添加按钮事件监听
        d3.select("#animate-bar").on("click", animateBarChart);
        d3.select("#animate-line").on("click", animateLineChart);

        // 添加注释
        svg2.append("text")
            .attr("x", width / 2)
            .attr("y", -10)
            .attr("text-anchor", "middle")
            .style("font-size", "12px")
            .style("font-style", "italic")
            .text("Note that the values are not to be exactly replicated");
    </script>
</body>
</html>


