<body>
    <h1 class="title">Model Usage Frequency Distribution (1980-2020)</h1>
    <p class="subtitle">Annual data with 5-year interval labels</p>
    <div class="chart-container">
        <div id="chart"></div>
        <div class="controls">
            <button id="show-all">Show All</button>
            <button id="hide-all">Hide All</button>
        </div>
        <div class="legend" id="legend"></div>
    </div>

    <script>
        // Set chart dimensions and margins
        const margin = { top: 40, right: 80, bottom: 50, left: 60 };
        const width = 800 - margin.left - margin.right;
        const height = 500 - margin.top - margin.bottom;

        // Create SVG container
        const svg = d3.select("#chart")
            .append("svg")
            .attr("width", width + margin.left + margin.right)
            .attr("height", height + margin.top + margin.bottom)
            .append("g")
            .attr("transform", `translate(${margin.left},${margin.top})`);

        // Create tooltip
        const tooltip = d3.select("body")
            .append("div")
            .attr("class", "tooltip");

        // Define data
        const categories = ["Set model", "Sequence model", "Vector model", "End-to-end"];
        const years = d3.range(1980, 2021); // All years from 1980 to 2020
        const labelYears = d3.range(1980, 2021, 5); // Only every 5 years for labels

        // Define colors with appropriate transparency
        const colors = {
            "Set model": { line: "rgba(65, 105, 225, 1)", area: "rgba(65, 105, 225, 0.3)" },
            "Sequence model": { line: "rgba(220, 20, 60, 1)", area: "rgba(220, 20, 60, 0.3)" },
            "Vector model": { line: "rgba(50, 205, 50, 1)", area: "rgba(50, 205, 50, 0.3)" },
            "End-to-end": { line: "rgba(255, 165, 0, 1)", area: "rgba(255, 165, 0, 0.3)" }
        };

        // Generate random data for all years
        const data = [];
        years.forEach(year => {
            const yearData = { year: year };
            categories.forEach(category => {
                // Generate random data but with some continuity (smoother transitions)
                if (year === 1980) {
                    yearData[category] = Math.floor(Math.random() * 11);
                } else {
                    const prevValue = data[data.length - 1][category];
                    const change = Math.floor(Math.random() * 3) - 1; // -1, 0, or 1
                    yearData[category] = Math.max(0, Math.min(10, prevValue + change));
                }
            });
            data.push(yearData);
        });

        // Create scales
        const xScale = d3.scaleLinear()
            .domain([1980, 2020])
            .range([0, width]);

        const yScale = d3.scaleLinear()
            .domain([0, 10])
            .range([height, 0]);

        // Create line generator
        const line = d3.line()
            .x(d => xScale(d.year))
            .y(d => yScale(d.value))
            .curve(d3.curveMonotoneX); // Smooth curve

        // Create area generator
        const area = d3.area()
            .x(d => xScale(d.year))
            .y0(height) // Bottom of the chart
            .y1(d => yScale(d.value))
            .curve(d3.curveMonotoneX);

        // Add grid lines
        const yTicks = yScale.ticks(6);
        svg.selectAll(".grid-line")
            .data(yTicks)
            .enter()
            .append("line")
            .attr("class", "grid-line")
            .attr("x1", 0)
            .attr("x2", width)
            .attr("y1", d => yScale(d))
            .attr("y2", d => yScale(d));

        // Add X axis with only 5-year interval labels
        svg.append("g")
            .attr("transform", `translate(0, ${height})`)
            .call(d3.axisBottom(xScale)
                .tickValues(labelYears)
                .tickFormat(d3.format("d")))
            .selectAll("text")
            .style("text-anchor", "middle");

        // Add Y axis
        svg.append("g")
            .call(d3.axisLeft(yScale).ticks(6).tickFormat(d => d));

        // Add X axis label
        svg.append("text")
            .attr("transform", `translate(${width / 2}, ${height + margin.bottom - 10})`)
            .style("text-anchor", "middle")
            .attr("class", "axis-label")
            .text("Year");

        // Add Y axis label
        svg.append("text")
            .attr("transform", "rotate(-90)")
            .attr("y", -margin.left + 15)
            .attr("x", -height / 2)
            .style("text-anchor", "middle")
            .attr("class", "axis-label")
            .text("Frequency");

        // Create line and area for each category
        categories.forEach(category => {
            const categoryData = data.map(d => ({ year: d.year, value: d[category], category: category }));
            
            // Add area path
            svg.append("path")
                .datum(categoryData)
                .attr("class", `area area-${category.replace(/\s+/g, '-')}`)
                .attr("d", area)
                .style("fill", colors[category].area)
                .style("opacity", 0.8);
            
            // Add line path
            svg.append("path")
                .datum(categoryData)
                .attr("class", `line line-${category.replace(/\s+/g, '-')}`)
                .attr("d", line)
                .style("stroke", colors[category].line)
                .style("opacity", 1);
            
            // Add data points for 5-year intervals only (to reduce clutter)
            svg.selectAll(`.dot-${category.replace(/\s+/g, '-')}`)
                .data(categoryData.filter(d => labelYears.includes(d.year)))
                .enter()
                .append("circle")
                .attr("class", `dot dot-${category.replace(/\s+/g, '-')}`)
                .attr("cx", d => xScale(d.year))
                .attr("cy", d => yScale(d.value))
                .attr("r", 5)
                .style("fill", colors[category].line)
                .on("mouseover", function(event, d) {
                    // Highlight point
                    d3.select(this)
                        .transition()
                        .duration(200)
                        .attr("r", 8);
                    
                    // Show tooltip
                    tooltip
                        .style("opacity", 1)
                        .html(`<strong>${d.category}</strong><br>Year: ${d.year}<br>Frequency: ${d.value}`)
                        .style("left", (event.pageX + 10) + "px")
                        .style("top", (event.pageY - 28) + "px");
                })
                .on("mouseout", function() {
                    // Restore original state
                    d3.select(this)
                        .transition()
                        .duration(200)
                        .attr("r", 5);
                    
                    // Hide tooltip
                    tooltip.style("opacity", 0);
                });
        });

        // Add legend
        const legend = d3.select("#legend");
        categories.forEach(category => {
            const legendItem = legend.append("div")
                .attr("class", "legend-item")
                .on("click", function() {
                    const lineElement = svg.select(`.line-${category.replace(/\s+/g, '-')}`).node();
                    const areaElement = svg.select(`.area-${category.replace(/\s+/g, '-')}`).node();
                    const dots = svg.selectAll(`.dot-${category.replace(/\s+/g, '-')}`);
                    
                    const isActive = d3.select(lineElement).style("opacity") === "1";
                    
                    // Toggle visibility
                    d3.select(lineElement)
                        .transition()
                        .duration(300)
                        .style("opacity", isActive ? 0 : 1);
                    
                    d3.select(areaElement)
                        .transition()
                        .duration(300)
                        .style("opacity", isActive ? 0 : 0.8);
                    
                    dots
                        .transition()
                        .duration(300)
                        .style("opacity", isActive ? 0 : 1);
                    
                    // Update legend item opacity
                    d3.select(this).style("opacity", isActive ? 0.5 : 1);
                });
            
            legendItem.append("div")
                .attr("class", "legend-color")
                .style("background-color", colors[category].line);
            
            legendItem.append("span")
                .text(category);
        });

        // Add chart title
        svg.append("text")
            .attr("x", width / 2)
            .attr("y", -10)
            .attr("text-anchor", "middle")
            .style("font-size", "16px")
            .style("font-weight", "bold")
            .text("Model Frequency Distribution");

        // Add control buttons
        document.getElementById('show-all').addEventListener('click', function() {
            categories.forEach(category => {
                const lineElement = svg.select(`.line-${category.replace(/\s+/g, '-')}`);
                const areaElement = svg.select(`.area-${category.replace(/\s+/g, '-')}`);
                const dots = svg.selectAll(`.dot-${category.replace(/\s+/g, '-')}`);
                const legendItem = d3.selectAll('.legend-item').filter((d, i) => i === categories.indexOf(category));
                
                lineElement.transition().duration(300).style("opacity", 1);
                areaElement.transition().duration(300).style("opacity", 0.8);
                dots.transition().duration(300).style("opacity", 1);
                legendItem.style("opacity", 1);
            });
        });

        document.getElementById('hide-all').addEventListener('click', function() {
            categories.forEach(category => {
                const lineElement = svg.select(`.line-${category.replace(/\s+/g, '-')}`);
                const areaElement = svg.select(`.area-${category.replace(/\s+/g, '-')}`);
                const dots = svg.selectAll(`.dot-${category.replace(/\s+/g, '-')}`);
                const legendItem = d3.selectAll('.legend-item').filter((d, i) => i === categories.indexOf(category));
                
                lineElement.transition().duration(300).style("opacity", 0);
                areaElement.transition().duration(300).style("opacity", 0);
                dots.transition().duration(300).style("opacity", 0);
                legendItem.style("opacity", 0.5);
            });
        });
    </script>
</body>
</html>


