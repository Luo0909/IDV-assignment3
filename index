            background: #4a90e2;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            transition: background 0.3s;
        }
        button:hover {
            background: #357abd;
        }
        button:disabled {
            background: #cccccc;
            cursor: not-allowed;
        }
        .tooltip {
            position: absolute;
            padding: 8px 12px;
            background: rgba(0, 0, 0, 0.7);
            color: white;
            border-radius: 4px;
            font-size: 14px;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.3s;
            z-index: 10;
        }
    </style>
</head>
<body>
    <div class="container">
        <div id="map"></div>
        <div class="controls">
            <div class="control-group">
                <button id="playAll">Play All Animations</button>
                <button id="reset">Reset</button>
            </div>
            <div class="control-group">
                <button id="toggleProvince">Show/Hide Zhejiang</button>
                <button id="toggleCircle">Show/Hide Circle</button>
            </div>
            <div class="control-group">
                <button id="changeColors">Change Color Theme</button>
                <button id="pulseEffect">Pulse Effect</button>
            </div>
        </div>
        <div class="tooltip" id="tooltip"></div>
    </div>

    <script>
        // Create SVG element
        const width = 800;
        const height = 500;
        
        const svg = d3.select("#map")
            .append("svg")
            .attr("width", width)
            .attr("height", height);
        
        // Add grid background
        const gridSize = 20;
        const gridPattern = svg.append("defs")
            .append("pattern")
            .attr("id", "grid")
            .attr("width", gridSize)
            .attr("height", gridSize)
            .attr("patternUnits", "userSpaceOnUse");
        
        gridPattern.append("rect")
            .attr("width", gridSize)
            .attr("height", gridSize)
            .attr("fill", "white");
        
        gridPattern.append("path")
            .attr("d", `M ${gridSize} 0 L 0 0 0 ${gridSize}`)
            .attr("fill", "none")
            .attr("stroke", "#e0e0e0")
            .attr("stroke-width", 1);
        
        // Add background rectangle
        svg.append("rect")
            .attr("width", width)
            .attr("height", height)
            .attr("fill", "url(#grid)");
        
        // Create projection and path generator
        const projection = d3.geoMercator()
            .center([120.5, 29.0]) // Approximate center of Zhejiang
            .scale(6000)
            .translate([width / 2, height / 2]);
        
        const path = d3.geoPath().projection(projection);
        
        // Global variables
        let provincePath, circle, centerDot, xMarker, label;
        let currentColorTheme = 0;
        let animationsPlaying = false;
        
        // Draw Zhejiang map
        function drawZhejiangMap() {
            // Simulated Zhejiang outline data
            const zhejiangOutline = [
                [118.5, 30.5], [119.2, 30.4], [119.8, 30.2], 
                [120.5, 30.0], [121.2, 29.8], [121.8, 29.5], 
                [122.0, 29.0], [121.8, 28.5], [121.2, 28.2], 
                [120.5, 28.0], [119.8, 27.8], [119.2, 27.6], 
                [118.5, 27.8], [118.0, 28.2], [117.8, 28.8], 
                [118.0, 29.5], [118.5, 30.5]
            ];
            
            // Close the polygon
            zhejiangOutline.push(zhejiangOutline[0]);
            
            const line = d3.line()
                .x(d => projection(d)[0])
                .y(d => projection(d)[1]);
            
            // Draw Zhejiang outline
            provincePath = svg.append("path")
                .attr("d", line(zhejiangOutline))
                .attr("fill", "#4a90e2")
                .attr("stroke", "#fff")
                .attr("stroke-width", 2)
                .attr("opacity", 0);
            
            // Ningbo coordinates - ensure inside Zhejiang outline
            const ningboCoords = [121.4, 29.8];
            const ningboPosition = projection(ningboCoords);
            
            // Add circle annotation
            const circleRadius = 60;
            circle = svg.append("circle")
                .attr("cx", ningboPosition[0])
                .attr("cy", ningboPosition[1])
                .attr("r", 0)
                .attr("fill", "none")
                .attr("stroke", "#e74c3c")
                .attr("stroke-width", 2)
                .attr("stroke-dasharray", "5,5");
            
            // Add center point marker
            centerDot = svg.append("circle")
                .attr("cx", ningboPosition[0])
                .attr("cy", ningboPosition[1])
                .attr("r", 0)
                .attr("fill", "#e74c3c");
            
            // Add Ningbo marker - white X
            xMarker = svg.append("text")
                .attr("x", ningboPosition[0])
                .attr("y", ningboPosition[1])
                .attr("dy", "0.35em")
                .attr("font-size", "16px")
                .attr("font-weight", "bold")
                .attr("fill", "#fff")
                .attr("text-anchor", "middle")
                .attr("opacity", 0)
                .text("X");
            
            // Add circle annotation text
            label = svg.append("text")
                .attr("x", ningboPosition[0] + circleRadius + 5)
                .attr("y", ningboPosition[1])
                .attr("font-size", "14px")
                .attr("font-weight", "bold")
                .attr("fill", "#e74c3c")
                .attr("opacity", 0)
                .text("B(x')");
            
            // Setup interactions
            setupInteractions();
        }
        
        // Setup interactions
        function setupInteractions() {
            const tooltip = d3.select("#tooltip");
            
            // Click map to change colors
            svg.on("click", function() {
                if (animationsPlaying) return;
                
                const currentColor = provincePath.attr("fill");
                const newColor = currentColor === "#4a90e2" ? "#2ecc71" : 
                                currentColor === "#2ecc71" ? "#9b59b6" : "#4a90e2";
                
                provincePath
                    .transition()
                    .duration(500)
                    .attr("fill", newColor);
                
                // Change circle color
                const currentCircleColor = circle.attr("stroke");
                const newCircleColor = currentCircleColor === "#e74c3c" ? "#3498db" : 
                                      currentCircleColor === "#3498db" ? "#f39c12" : "#e74c3c";
                
                circle
                    .transition()
                    .duration(500)
                    .attr("stroke", newCircleColor);
                
                centerDot
                    .transition()
                    .duration(500)
                    .attr("fill", newCircleColor);
                
                label
                    .transition()
                    .duration(500)
                    .attr("fill", newCircleColor);
            });
            
            // Hover effects
            provincePath
                .on("mouseover", function(event) {
                    tooltip
                        .style("opacity", 1)
                        .html("Zhejiang Province<br>Click to change color")
                        .style("left", (event.pageX + 10) + "px")
                        .style("top", (event.pageY - 28) + "px");
                })
                .on("mouseout", function() {
                    tooltip.style("opacity", 0);
                });
            
            circle
                .on("mouseover", function(event) {
                    tooltip
                        .style("opacity", 1)
                        .html("Ningbo City Marker<br>Center: X<br>Label: B(x')")
                        .style("left", (event.pageX + 10) + "px")
                        .style("top", (event.pageY - 28) + "px");
                })
                .on("mouseout", function() {
                    tooltip.style("opacity", 0);
                });
        }
        
        // Play all animations
        function playAllAnimations() {
            animationsPlaying = true;
            d3.select("#playAll").attr("disabled", true);
            
            // Reset all elements
            resetAnimations();
            
            // Play Zhejiang display animation
            provincePath
                .transition()
                .duration(1500)
                .attr("opacity", 0.8)
                .on("end", function() {
                    // Play center point animation
                    centerDot
                        .transition()
                        .duration(800)
                        .attr("r", 12)
                        .on("end", function() {
                            // Play circle annotation animation
                            circle
                                .transition()
                                .duration(1000)
                                .attr("r", 60)
                                .on("end", function() {
                                    // Play X marker and label animation
                                    xMarker
                                        .transition()
                                        .duration(500)
                                        .attr("opacity", 1);
                                    
                                    label
                                        .transition()
                                        .duration(500)
                                        .attr("opacity", 1)
                                        .on("end", function() {
                                            animationsPlaying = false;
                                            d3.select("#playAll").attr("disabled", null);
                                        });
                                });
                        });
                });
        }
        
        // Reset animations
        function resetAnimations() {
            provincePath
                .interrupt()
                .attr("opacity", 0);
            
            circle
                .interrupt()
                .attr("r", 0);
            
            centerDot
                .interrupt()
                .attr("r", 0);
            
            xMarker
                .interrupt()
                .attr("opacity", 0);
            
            label
                .interrupt()
                .attr("opacity", 0);
        }
        
        // Toggle Zhejiang visibility
        function toggleProvince() {
            const currentOpacity = parseFloat(provincePath.attr("opacity"));
            provincePath
                .transition()
                .duration(500)
                .attr("opacity", currentOpacity > 0 ? 0 : 0.8);
        }
        
        // Toggle circle visibility
        function toggleCircle() {
            const currentRadius = parseFloat(circle.attr("r"));
            circle
                .transition()
                .duration(500)
                .attr("r", currentRadius > 0 ? 0 : 60);
            
            const currentLabelOpacity = parseFloat(label.attr("opacity"));
            label
                .transition()
                .duration(500)
                .attr("opacity", currentLabelOpacity > 0 ? 0 : 1);
        }
        
        // Change color theme
        function changeColors() {
            const themes = [
                { province: "#4a90e2", circle: "#e74c3c" }, // Blue-Red theme
                { province: "#2ecc71", circle: "#3498db" }, // Green-Blue theme
                { province: "#9b59b6", circle: "#f39c12" }  // Purple-Orange theme
            ];
            
            currentColorTheme = (currentColorTheme + 1) % themes.length;
            const theme = themes[currentColorTheme];
            
            provincePath
                .transition()
                .duration(500)
                .attr("fill", theme.province);
            
            circle
                .transition()
                .duration(500)
                .attr("stroke", theme.circle);
            
            centerDot
                .transition()
                .duration(500)
                .attr("fill", theme.circle);
            
            label
                .transition()
                .duration(500)
                .attr("fill", theme.circle);
        }
        
        // Pulse effect
        function pulseEffect() {
            circle
                .transition()
                .duration(300)
                .attr("stroke-width", 4)
                .transition()
                .duration(300)
                .attr("stroke-width", 2)
                .transition()
                .duration(300)
                .attr("stroke-width", 4)
                .transition()
                .duration(300)
                .attr("stroke-width", 2);
            
            centerDot
                .transition()
                .duration(300)
                .attr("r", 16)
                .transition()
                .duration(300)
                .attr("r", 12)
                .transition()
                .duration(300)
                .attr("r", 16)
                .transition()
                .duration(300)
                .attr("r", 12);
        }
        
        // Initialize map
        drawZhejiangMap();
        
        // Setup button event listeners
        d3.select("#playAll").on("click", playAllAnimations);
        d3.select("#reset").on("click", resetAnimations);
        d3.select("#toggleProvince").on("click", toggleProvince);
        d3.select("#toggleCircle").on("click", toggleCircle);
        d3.select("#changeColors").on("click", changeColors);
        d3.select("#pulseEffect").on("click", pulseEffect);
    </script>
</body>
</html>


