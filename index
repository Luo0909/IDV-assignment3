</head>
<body>
    <div class="chart-container">
        <h2 class="title">Bimodal Probability Density Function</h2>
        <p class="subtitle">Left curve has a linear segment between x=-1.9 and x=-0.8</p>
        <div id="chart"></div>
        <div class="controls">
            <button id="toggle-curves">Toggle Curves</button>
            <button id="reset-view">Reset View</button>
            <button id="animate">Animate</button>
        </div>
    </div>

    <script>
        // 设置图表尺寸和边距
        const margin = { top: 20, right: 30, bottom: 50, left: 50 };
        const width = 800 - margin.left - margin.right;
        const height = 450 - margin.top - margin.bottom;

        // 创建SVG元素
        const svg = d3.select("#chart")
            .append("svg")
            .attr("width", width + margin.left + margin.right)
            .attr("height", height + margin.top + margin.bottom)
            .append("g")
            .attr("transform", `translate(${margin.left},${margin.top})`);

        // 创建工具提示
        const tooltip = d3.select("body")
            .append("div")
            .attr("class", "tooltip");

        // 定义x和y比例尺
        const xScale = d3.scaleLinear()
            .domain([-1.8, 5])
            .range([0, width]);

        const yScale = d3.scaleLinear()
            .domain([0, 0.4])
            .range([height, 0]);

        // 添加网格线
        svg.append("g")
            .attr("class", "grid")
            .attr("transform", `translate(0,${height})`)
            .call(d3.axisBottom(xScale)
                .tickSize(-height)
                .tickFormat("")
            );

        svg.append("g")
            .attr("class", "grid")
            .call(d3.axisLeft(yScale)
                .tickSize(-width)
                .tickFormat("")
            );

        // 添加坐标轴
        svg.append("g")
            .attr("transform", `translate(0,${height})`)
            .call(d3.axisBottom(xScale))
            .append("text")
            .attr("x", width / 2)
            .attr("y", 35)
            .attr("fill", "#2c3e50")
            .attr("class", "axis-label")
            .text("x");

        svg.append("g")
            .call(d3.axisLeft(yScale))
            .append("text")
            .attr("transform", "rotate(-90)")
            .attr("y", -35)
            .attr("x", -height / 2)
            .attr("fill", "#2c3e50")
            .attr("class", "axis-label")
            .text("Probability Density");

        // 正态分布函数
        function normalDensity(x, mean, stdDev) {
            return (1 / (stdDev * Math.sqrt(2 * Math.PI))) * 
                   Math.exp(-0.5 * Math.pow((x - mean) / stdDev, 2));
        }

        // 生成数据点（从x=-1.8开始）
        const dataPoints = [];
        for (let x = -1.8; x <= 5; x += 0.05) {
            // 右侧正态分布曲线 (以x=2为中心)
            const rightDensity = normalDensity(x, 2, 1);
            
            // 左侧正态分布曲线 (以x=0为中心)
            let leftDensity;
            if (x >= -1.9 && x <= -0.8) {
                // 在x=-1.9到x=-0.8范围内为直线
                const densityAtStart = normalDensity(-1.9, 0, 1);
                const densityAtEnd = normalDensity(-0.8, 0, 1);
                const slope = (densityAtEnd - densityAtStart) / (-0.8 - (-1.9));
                leftDensity = densityAtStart + slope * (x - (-1.9));
            } else {
                leftDensity = normalDensity(x, 0, 1);
            }
            
            dataPoints.push({
                x: x,
                rightDensity: rightDensity,
                leftDensity: leftDensity
            });
        }

        // 创建曲线生成器
        const line = d3.line()
            .x(d => xScale(d.x))
            .y(d => yScale(d.density))
            .curve(d3.curveMonotoneX);

        // 绘制右侧正态分布曲线
        const rightLineData = dataPoints.map(d => ({ x: d.x, density: d.rightDensity }));
        const rightCurve = svg.append("path")
            .datum(rightLineData)
            .attr("class", "curve")
            .attr("fill", "none")
            .attr("stroke", "#3498db")
            .attr("stroke-width", 3)
            .attr("d", line);

        // 绘制左侧正态分布曲线
        const leftLineData = dataPoints.map(d => ({ x: d.x, density: d.leftDensity }));
        const leftCurve = svg.append("path")
            .datum(leftLineData)
            .attr("class", "curve")
            .attr("fill", "none")
            .attr("stroke", "#e74c3c")
            .attr("stroke-width", 3)
            .attr("d", line);

        // 添加特殊点标记
        // 右侧曲线经过(2, 0.25)的点
        const rightPoint = svg.append("circle")
            .attr("cx", xScale(2))
            .attr("cy", yScale(0.25))
            .attr("r", 6)
            .attr("fill", "#3498db")
            .attr("stroke", "white")
            .attr("stroke-width", 2)
            .on("mouseover", function(event) {
                tooltip.style("opacity", 1)
                    .html(`Right Normal Distribution<br>x=2, y=0.25<br>Mean=2, Std Dev=1`)
                    .style("left", (event.pageX + 10) + "px")
                    .style("top", (event.pageY - 28) + "px");
            })
            .on("mouseout", function() {
                tooltip.style("opacity", 0);
            });

        // 左侧曲线直线段的起点和终点
        const leftStartPoint = svg.append("circle")
            .attr("cx", xScale(-1.8))
            .attr("cy", yScale(normalDensity(-1.8, 0, 1)))
            .attr("r", 6)
            .attr("fill", "#e74c3c")
            .attr("stroke", "white")
            .attr("stroke-width", 2)
            .on("mouseover", function(event) {
                tooltip.style("opacity", 1)
                    .html(`Left Curve Start Point<br>x=-1.8`)
                    .style("left", (event.pageX + 10) + "px")
                    .style("top", (event.pageY - 28) + "px");
            })
            .on("mouseout", function() {
                tooltip.style("opacity", 0);
            });

        const leftEndPoint = svg.append("circle")
            .attr("cx", xScale(-0.8))
            .attr("cy", yScale(normalDensity(-0.8, 0, 1)))
            .attr("r", 6)
            .attr("fill", "#e74c3c")
            .attr("stroke", "white")
            .attr("stroke-width", 2)
            .on("mouseover", function(event) {
                tooltip.style("opacity", 1)
                    .html(`Left Curve Linear Segment End<br>x=-0.8`)
                    .style("left", (event.pageX + 10) + "px")
                    .style("top", (event.pageY - 28) + "px");
            })
            .on("mouseout", function() {
                tooltip.style("opacity", 0);
            });

        // 添加图例
        const legend = svg.append("g")
            .attr("class", "legend")
            .attr("transform", `translate(${width - 200}, 20)`);

        legend.append("rect")
            .attr("x", 0)
            .attr("y", 0)
            .attr("width", 16)
            .attr("height", 16)
            .attr("fill", "#e74c3c");

        legend.append("text")
            .attr("x", 25)
            .attr("y", 12)
            .attr("font-size", "13px")
            .text("Left Normal Distribution (μ=0)");

        legend.append("rect")
            .attr("x", 0)
            .attr("y", 25)
            .attr("width", 16)
            .attr("height", 16)
            .attr("fill", "#3498db");

        legend.append("text")
            .attr("x", 25)
            .attr("y", 37)
            .attr("font-size", "13px")
            .text("Right Normal Distribution (μ=2)");

        // 添加注释
        svg.append("text")
            .attr("class", "annotation")
            .attr("x", xScale(2.5))
            .attr("y", yScale(0.25) - 15)
            .text("Key Point (2, 0.25)");

        svg.append("line")
            .attr("x1", xScale(2.4))
            .attr("y1", yScale(0.25) - 10)
            .attr("x2", xScale(2))
            .attr("y2", yScale(0.25))
            .attr("stroke", "#7f8c8d")
            .attr("stroke-width", 1)
            .attr("stroke-dasharray", "3,3");

        // 添加直线段标注
        svg.append("text")
            .attr("class", "annotation")
            .attr("x", xScale(-1.3))
            .attr("y", yScale(0.15))
            .text("Linear Segment");

        svg.append("line")
            .attr("x1", xScale(-1.3))
            .attr("y1", yScale(0.15) - 5)
            .attr("x2", xScale(-1.35))
            .attr("y2", yScale(0.1))
            .attr("stroke", "#7f8c8d")
            .attr("stroke-width", 1)
            .attr("stroke-dasharray", "3,3");

        // 交互功能
        let curvesVisible = true;
        let animationInProgress = false;

        // 切换曲线可见性
        d3.select("#toggle-curves").on("click", function() {
            if (animationInProgress) return;
            
            curvesVisible = !curvesVisible;
            const opacity = curvesVisible ? 1 : 0;
            
            rightCurve.transition().duration(800).style("opacity", opacity);
            leftCurve.transition().duration(800).style("opacity", opacity);
            rightPoint.transition().duration(800).style("opacity", opacity);
            leftStartPoint.transition().duration(800).style("opacity", opacity);
            leftEndPoint.transition().duration(800).style("opacity", opacity);
        });

        // 重置视图
        d3.select("#reset-view").on("click", function() {
            if (animationInProgress) return;
            
            rightCurve.transition().duration(800).style("opacity", 1);
            leftCurve.transition().duration(800).style("opacity", 1);
            rightPoint.transition().duration(800).style("opacity", 1);
            leftStartPoint.transition().duration(800).style("opacity", 1);
            leftEndPoint.transition().duration(800).style("opacity", 1);
            
            curvesVisible = true;
        });

        // 动画效果
        d3.select("#animate").on("click", function() {
            if (animationInProgress) return;
            
            animationInProgress = true;
            d3.select("#animate").attr("disabled", true);
            
            // 重置所有元素为初始状态
            rightCurve
                .attr("stroke-dasharray", function() {
                    const length = this.getTotalLength();
                    return length + " " + length;
                })
                .attr("stroke-dashoffset", function() {
                    return this.getTotalLength();
                })
                .style("opacity", 1);
                
            leftCurve
                .attr("stroke-dasharray", function() {
                    const length = this.getTotalLength();
                    return length + " " + length;
                })
                .attr("stroke-dashoffset", function() {
                    return this.getTotalLength();
                })
                .style("opacity", 1);
                
            rightPoint.style("opacity", 0);
            leftStartPoint.style("opacity", 0);
            leftEndPoint.style("opacity", 0);
            
            // 执行动画
            rightCurve.transition()
                .duration(2000)
                .ease(d3.easeLinear)
                .attr("stroke-dashoffset", 0)
                .on("end", function() {
                    leftCurve.transition()
                        .duration(2000)
                        .ease(d3.easeLinear)
                        .attr("stroke-dashoffset", 0)
                        .on("end", function() {
                            // 显示点标记
                            rightPoint.transition()
                                .duration(500)
                                .style("opacity", 1);
                            leftStartPoint.transition()
                                .duration(500)
                                .style("opacity", 1);
                            leftEndPoint.transition()
                                .duration(500)
                                .style("opacity", 1)
                                .on("end", function() {
                                    animationInProgress = false;
                                    d3.select("#animate").attr("disabled", null);
                                });
                        });
                });
        });

        // 初始动画
        setTimeout(function() {
            d3.select("#animate").node().click();
        }, 500);
    </script>
</body>
</html>


