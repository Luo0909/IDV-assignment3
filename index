            pointer-events: none;
            opacity: 0;
            transition: opacity 0.3s;
            z-index: 10;
        }
        .highlight {
            filter: drop-shadow(0 0 8px rgba(52, 152, 219, 0.8));
        }
        .pulse {
            animation: pulse 1.5s infinite;
