</head>
<body>
    <div class="container">
        <h1>Word Network Visualization</h1>
        <div class="subtitle">
            <p>Network showing relationships between keywords extracted from tweets and related words</p>
        </div>
        
        <div class="legend">
            <div class="legend-item">
                <div class="legend-color original"></div>
                <span>Original Keywords</span>
            </div>
            <div class="legend-item">
                <div class="legend-color generated"></div>
                <span>Generated Related Words</span>
            </div>
            <div class="legend-item">
                <div class="legend-color bridge"></div>
                <span>Bridge Words</span>
            </div>
        </div>
        
        <div class="tweet-container">
            <div class="tweet">
                <div class="tweet-text">"I was in crowd of 50000. It was absolutely amazing experience for being my first ever protest."</div>
                <div class="tweet-keywords">Keywords: crowd, protest</div>
            </div>
            <div class="tweet">
                <div class="tweet-text">"Earthquake #sigir2017, but suspect to the Japanese, this was just a tremor."</div>
                <div class="tweet-keywords">Keywords: Earthquake, tremor</div>
            </div>
        </div>
        
        <div class="network-labels">
            <div class="network-label left">Social Event Network</div>
            <div class="network-label right">Natural Phenomenon Network</div>
        </div>
        
        <div id="network"></div>
        
        <div class="controls">
            <button id="reset">Reset Layout</button>
            <button id="center">Center Network</button>
        </div>
    </div>

    <script>
        // Data for the word network
        const wordData = {
            nodes: [
                // Original keywords - Social Event Network
                { id: "crowd", group: "original", network: "social", description: "A large number of people gathered together" },
                { id: "protest", group: "original", network: "social", description: "A statement or action expressing disapproval of or objection to something" },
                
                // Generated related words for crowd
                { id: "people", group: "generated", network: "social", description: "Human beings in general or considered collectively" },
                { id: "gathering", group: "generated", network: "social", description: "An assembly or meeting, especially a social or festive one" },
                { id: "assembly", group: "generated", network: "social", description: "A group of people gathered together in one place for a common purpose" },
                { id: "mob", group: "generated", network: "social", description: "A large crowd of people, especially one that is disorderly and intent on causing trouble" },
                { id: "mass", group: "generated", network: "social", description: "A large number of people or objects crowded together" },
                
                // Generated related words for protest
                { id: "demonstration", group: "generated", network: "social", description: "A public meeting or march protesting against something or expressing views on a political issue" },
                { id: "rally", group: "generated", network: "social", description: "A mass meeting of people making a political protest or showing support for a cause" },
                { id: "march", group: "generated", network: "social", description: "A walk by a group of people to protest about something" },
                { id: "resistance", group: "generated", network: "social", description: "The refusal to accept or comply with something" },
                { id: "objection", group: "generated", network: "social", description: "An expression or feeling of disapproval or opposition" },
                
                // Original keywords - Natural Phenomenon Network
                { id: "Earthquake", group: "original", network: "natural", description: "A sudden and violent shaking of the ground" },
                { id: "tremor", group: "original", network: "natural", description: "A slight earthquake or shaking movement" },
                
                // Generated related words for Earthquake
                { id: "seismic", group: "generated", network: "natural", description: "Relating to earthquakes or other vibrations of the earth and its crust" },
                { id: "quake", group: "generated", network: "natural", description: "An earthquake" },
                { id: "shaking", group: "generated", network: "natural", description: "Moving or causing to move with short, quick movements from side to side or up and down" },
                { id: "temblor", group: "generated", network: "natural", description: "An earthquake" },
                { id: "aftershock", group: "generated", network: "natural", description: "A smaller earthquake following the main shock of a large earthquake" },
                
                // Generated related words for tremor
                { id: "vibration", group: "generated", network: "natural", description: "An instance of vibrating; a slight shaking movement" },
                { id: "quiver", group: "generated", network: "natural", description: "A slight trembling movement or sound, especially one caused by a sudden strong emotion" },
                { id: "shudder", group: "generated", network: "natural", description: "A sudden convulsive movement of the body" },
                { id: "oscillation", group: "generated", network: "natural", description: "Movement back and forth in a regular rhythm" },
                { id: "microseism", group: "generated", network: "natural", description: "A feeble tremor of the earth's surface" },
                
                // Bridge words connecting both networks
                { id: "movement", group: "bridge", network: "bridge", description: "An act of changing physical location or position" },
                { id: "intensity", group: "bridge", network: "bridge", description: "The quality of being intense" },
                { id: "energy", group: "bridge", network: "bridge", description: "The strength and vitality required for sustained activity" },
                { id: "wave", group: "bridge", network: "bridge", description: "A disturbance that transfers energy from one place to another" }
            ],
            links: [
                // Links for crowd
                { source: "crowd", target: "people", strength: 0.9 },
                { source: "crowd", target: "gathering", strength: 0.8 },
                { source: "crowd", target: "assembly", strength: 0.7 },
                { source: "crowd", target: "mob", strength: 0.6 },
                { source: "crowd", target: "mass", strength: 0.8 },
                
                // Links for protest
                { source: "protest", target: "demonstration", strength: 0.9 },
                { source: "protest", target: "rally", strength: 0.8 },
                { source: "protest", target: "march", strength: 0.7 },
                { source: "protest", target: "resistance", strength: 0.6 },
                { source: "protest", target: "objection", strength: 0.8 },
                
                // Links for Earthquake
                { source: "Earthquake", target: "seismic", strength: 0.9 },
                { source: "Earthquake", target: "quake", strength: 0.9 },
                { source: "Earthquake", target: "shaking", strength: 0.7 },
                { source: "Earthquake", target: "temblor", strength: 0.8 },
                { source: "Earthquake", target: "aftershock", strength: 0.6 },
                
                // Links for tremor
                { source: "tremor", target: "vibration", strength: 0.9 },
                { source: "tremor", target: "quiver", strength: 0.7 },
                { source: "tremor", target: "shudder", strength: 0.6 },
                { source: "tremor", target: "oscillation", strength: 0.5 },
                { source: "tremor", target: "microseism", strength: 0.8 },
                
                // Cross-category links within networks
                { source: "crowd", target: "protest", strength: 0.5 },
                { source: "Earthquake", target: "tremor", strength: 0.8 },
                { source: "shaking", target: "vibration", strength: 0.6 },
                { source: "quake", target: "tremor", strength: 0.7 },
                
                // Bridge connections - Social to Bridge
                { source: "crowd", target: "movement", strength: 0.4 },
                { source: "protest", target: "movement", strength: 0.5 },
                { source: "march", target: "movement", strength: 0.6 },
                { source: "crowd", target: "energy", strength: 0.3 },
                { source: "protest", target: "intensity", strength: 0.4 },
                { source: "rally", target: "energy", strength: 0.4 },
                
                // Bridge connections - Natural to Bridge
                { source: "Earthquake", target: "movement", strength: 0.7 },
                { source: "tremor", target: "movement", strength: 0.6 },
                { source: "shaking", target: "movement", strength: 0.8 },
                { source: "Earthquake", target: "energy", strength: 0.7 },
                { source: "tremor", target: "intensity", strength: 0.5 },
                { source: "vibration", target: "wave", strength: 0.6 },
                { source: "oscillation", target: "wave", strength: 0.7 },
                
                // Bridge internal connections
                { source: "movement", target: "energy", strength: 0.5 },
                { source: "movement", target: "intensity", strength: 0.4 },
                { source: "energy", target: "intensity", strength: 0.6 },
                { source: "energy", target: "wave", strength: 0.5 },
                { source: "intensity", target: "wave", strength: 0.4 }
            ]
        };

        // Set up the SVG container
        const svg = d3.select("#network")
            .append("svg")
            .attr("width", "100%")
            .attr("height", "100%");

        const width = document.getElementById("network").clientWidth;
        const height = document.getElementById("network").clientHeight;

        // Create tooltip
        const tooltip = d3.select("body")
            .append("div")
            .attr("class", "tooltip")
            .style("opacity", 0);

        // Set up the simulation with initial positions
        const simulation = d3.forceSimulation(wordData.nodes)
            .force("link", d3.forceLink(wordData.links).id(d => d.id).distance(d => 150 - (d.strength * 100)))
            .force("charge", d3.forceManyBody().strength(-1000))
            .force("center", d3.forceCenter(width / 2, height / 2))
            .force("collision", d3.forceCollide().radius(50))
            .force("x", d3.forceX().strength(0.1).x(d => {
                if (d.network === "social") return width * 0.3;
                if (d.network === "natural") return width * 0.7;
                return width / 2;
            }));

        // Create links
        const link = svg.append("g")
            .attr("class", "links")
            .selectAll("line")
            .data(wordData.links)
            .enter()
            .append("line")
            .attr("class", "link")
            .attr("stroke-width", d => d.strength * 3);

        // Create nodes
        const node = svg.append("g")
            .attr("class", "nodes")
            .selectAll("g")
            .data(wordData.nodes)
            .enter()
            .append("g")
            .attr("class", "node")
            .call(d3.drag()
                .on("start", dragstarted)
                .on("drag", dragged)
                .on("end", dragended));

        // Add circles to nodes
        node.append("circle")
            .attr("r", d => {
                if (d.group === "original") return 18;
                if (d.group === "bridge") return 14;
                return 12;
            })
            .attr("fill", d => {
                if (d.group === "original") return "#e74c3c";
                if (d.group === "bridge") return "#9b59b6";
                return "#3498db";
            })
            .attr("stroke", d => {
                if (d.group === "original") return "#c0392b";
                if (d.group === "bridge") return "#8e44ad";
                return "#2980b9";
            })
            .attr("stroke-width", 2)
            .on("mouseover", function(event, d) {
                tooltip.transition()
                    .duration(200)
                    .style("opacity", .9);
                tooltip.html(`<strong>${d.id}</strong><br/>${d.description}`)
                    .style("left", (event.pageX + 10) + "px")
                    .style("top", (event.pageY - 28) + "px");
                    
                // Highlight connected nodes and links
                link.style("stroke", l => 
                    l.source.id === d.id || l.target.id === d.id ? 
                    (d.group === "original" ? "#e74c3c" : d.group === "bridge" ? "#9b59b6" : "#3498db") : "#95a5a6")
                   .style("stroke-width", l => 
                    l.source.id === d.id || l.target.id === d.id ? 
                    d.group === "original" ? 4 : 3 : 1);
                    
                node.select("circle").style("opacity", n => 
                    n.id === d.id || wordData.links.some(l => 
                        (l.source.id === d.id && l.target.id === n.id) || 
                        (l.target.id === d.id && l.source.id === n.id)) ? 1 : 0.3);
            })
            .on("mouseout", function() {
                tooltip.transition()
                    .duration(500)
                    .style("opacity", 0);
                    
                // Reset styles
                link.style("stroke", "#95a5a6")
                   .style("stroke-width", d => d.strength * 3);
                   
                node.select("circle").style("opacity", 1);
            });

        // Add labels to nodes
        node.append("text")
            .text(d => d.id)
            .attr("x", 0)
            .attr("y", d => {
                if (d.group === "original") return 25;
                if (d.group === "bridge") return 20;
                return 18;
            })
            .attr("text-anchor", "middle")
            .attr("font-size", d => {
                if (d.group === "original") return "14px";
                if (d.group === "bridge") return "13px";
                return "12px";
            })
            .attr("font-weight", d => d.group === "original" ? "bold" : "normal")
            .attr("fill", "#2c3e50");

        // Update positions on each tick
        simulation.on("tick", () => {
            link
                .attr("x1", d => d.source.x)
                .attr("y1", d => d.source.y)
                .attr("x2", d => d.target.x)
                .attr("y2", d => d.target.y);

            node
                .attr("transform", d => `translate(${d.x}, ${d.y})`);
        });

        // Drag functions
        function dragstarted(event, d) {
            if (!event.active) simulation.alphaTarget(0.3).restart();
            d.fx = d.x;
            d.fy = d.y;
        }

        function dragged(event, d) {
            d.fx = event.x;
            d.fy = event.y;
        }

        function dragended(event, d) {
            if (!event.active) simulation.alphaTarget(0);
            d.fx = null;
            d.fy = null;
        }

        // Handle window resize
        window.addEventListener('resize', function() {
            const newWidth = document.getElementById("network").clientWidth;
            const newHeight = document.getElementById("network").clientHeight;
            
            svg.attr("width", newWidth)
               .attr("height", newHeight);
            
            simulation.force("center", d3.forceCenter(newWidth / 2, newHeight / 2))
                     .alpha(0.3)
                     .restart();
        });

        // Reset button functionality
        document.getElementById('reset').addEventListener('click', function() {
            simulation.alpha(1).restart();
            simulation.force("x", d3.forceX().strength(0.1).x(d => {
                if (d.network === "social") return width * 0.3;
                if (d.network === "natural") return width * 0.7;
                return width / 2;
            })).alpha(0.3).restart();
        });

        // Center button functionality
        document.getElementById('center').addEventListener('click', function() {
            simulation.force("center", d3.forceCenter(width / 2, height / 2))
                     .force("x", null)
                     .alpha(0.3)
                     .restart();
        });
    </script>
</body>
</html>


